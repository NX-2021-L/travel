          "description": "ISO date; required for returned and left",
          "type": "string"
        },
        "kind": {
          "enum": [
            "returned",
            "left",
            "together",
            "leave_out"
          ],
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "description": "Optional agent session id, recorded in the author stamp",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "record_ids"
      ],
      "type": "object"
    },
    "retire_trip_correction": {
