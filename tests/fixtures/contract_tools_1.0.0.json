  "new_tool_descriptions": {
    "answer_trip_question": "Pass back the chosen answer to a prepared question; shows the correction it writes (dry_run), then writes it.",
    "cancel_car_rental": "Cancel a car rental softly. Idempotent. No hard deletes.",
    "cancel_drive": "Cancel a drive softly. Idempotent. No hard deletes.",
    "cancel_lodging": "Cancel a lodging softly. Idempotent. No hard deletes.",
    "create_car_rental": "Create a car rental record. Rejects duplicates on the natural key.",
    "create_drive": "Create a drive record. Rejects duplicates on the natural key.",
    "create_lodging": "Create a lodging record. Rejects duplicates on the natural key.",
    "get_home_places": "Get the home places for one residence, or for all residences.",
    "get_travel_record": "Get one lodging, car rental or drive record by id.",
    "get_trip": "Get one trip, with the rule behind each boundary.",
    "list_trips": "List trips: under way, then upcoming, then past (newest first).",
    "list_undecided_trips": "List trips with an open flag or signal, each with one prepared question and its answers.",
    "record_trip_correction": "Record a correction in free form, for a case the prepared answers miss.",
    "retire_trip_correction": "Retire a correction, reopening what it closed. Never deletes.",
    "search_travel_records": "Search lodging, car rental and drive records. Paginated.",
    "set_home_places": "Set the places that count as leaving a residence (airports by code, cities).",
    "update_car_rental": "Update mutable fields of a car rental; identity fields (pickup_date, pickup_place, company, confirmation_code) cannot change: cancel and record again.",
    "update_drive": "Update mutable fields of a drive; identity fields (date, origin, destination, sequence) cannot change: cancel and record again.",
    "update_lodging": "Update mutable fields of a lodging; identity fields (first_night, name, city, state, country) cannot change: cancel and record again."
  },
  "new_tool_schemas": {
    "answer_trip_question": {
      "properties": {
        "answer_id": {
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "session": {
          "description": "Optional agent session id, recorded in the author stamp",
          "type": "string"
        },
        "trip_key": {
          "type": "string"
        }
      },
      "required": [
        "trip_key",
        "question_id",
        "answer_id"
      ],
      "type": "object"
    },
    "cancel_car_rental": {
      "properties": {
        "car_rental_id": {
          "description": "The car rental record id",
          "type": "string"
        }
      },
      "required": [
        "car_rental_id"
      ],
      "type": "object"
    },
    "cancel_drive": {
      "properties": {
        "drive_id": {
          "description": "The drive record id",
          "type": "string"
        }
      },
      "required": [
        "drive_id"
      ],
      "type": "object"
    },
    "cancel_lodging": {
      "properties": {
        "lodging_id": {
          "description": "The lodging record id",
          "type": "string"
        }
      },
      "required": [
        "lodging_id"
      ],
      "type": "object"
    },
    "create_car_rental": {
      "properties": {
        "company": {
          "type": "string"
        },
        "confirmation_code": {
          "type": "string"
        },
        "dropoff_date": {
          "description": "ISO date",
          "type": "string"
        },
        "dropoff_place": {
          "type": "string"
        },
        "pickup_date": {
          "description": "ISO date",
          "type": "string"
        },
        "pickup_place": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "company",
        "pickup_place",
        "pickup_date"
      ],
      "type": "object"
    },
    "create_drive": {
      "properties": {
        "date": {
          "description": "ISO date",
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "means": {
          "description": "Means of travel",
          "enum": [
            "road"
          ],
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "sequence": {
          "description": "Order within the day",
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "via": {
          "description": "Places passed through",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "date",
        "origin",
        "destination"
      ],
      "type": "object"
    },
    "create_lodging": {
      "properties": {
        "address": {
          "description": "Street address; stored as given, never parsed",
          "type": "string"
        },
        "city": {
          "description": "City",
          "type": "string"
        },
        "confirmation_code": {
          "type": "string"
        },
        "country": {
          "description": "Country",
          "type": "string"
        },
        "first_night": {
          "description": "First night (ISO date); nights are inclusive",
          "type": "string"
        },
        "last_night": {
          "description": "Last night (ISO date)",
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "name": {
          "description": "Property name",
          "type": "string"
        },
        "place_label": {
          "description": "Place as booked",
          "type": "string"
        },
        "source": {
          "description": "Where the record came from",
          "type": "string"
        },
        "state": {
          "description": "State or region",
          "type": "string"
        }
      },
      "required": [
        "name",
        "city",
        "state",
        "country",
        "first_night",
        "last_night"
      ],
      "type": "object"
    },
    "get_home_places": {
      "properties": {
        "residence_uid": {
          "description": "Residence period id; omit for all",
          "type": "string"
        }
      },
      "type": "object"
    },
    "get_travel_record": {
      "properties": {
