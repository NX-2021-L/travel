            "type": "object"
          },
          "type": "array"
        },
        "residence_uid": {
          "type": "string"
        },
        "valid_from": {
          "type": "string"
        },
        "valid_to": {
          "type": "string"
        }
      },
      "required": [
        "residence_uid",
        "places"
