# The second target of travel's one deploy path (MOM-TSK-007-0F, lane N6F): her deployment, in her own AWS account.
# Same format and loader as deploy/settings.env. Her account id is NEVER written in this repository: the workflow
# reads it from the repository variable named by ACCOUNT_ID_VARIABLE, and scripts/target_ops.py builds her role
# ARNs from it at run time. Not secret: names and regions.

# --- the target ---
TARGET_NAME=nana
ACCOUNT_ID_VARIABLE=NANA_AWS_ACCOUNT_ID
AWS_REGION=us-west-2
STACK_NAME=nana-travel-deployment
DEPLOY_ROLE_NAME=nana-travel-deploy-github-role

# --- function settings (contract.SETTINGS) ---
TABLE_NAME=nana-travel-flights
RECORDS_TABLE_NAME=nana-travel-records
SURFACE_NAME=nana-travel
DOOR_MODE=internal

# --- names the stack gives its resources (MOM-TSK-021: every resource in her account is nana-*; her deploy role's grants name nana-travel-* only) ---
# This file is the ONE place her deployment is named. The template, workflow, scripts and function derive every name from it
# (tests/test_resource_names_from_settings.py fails the build on a literal io-prefixed travel name where a name is formed, or a non-nana- name here).
FUNCTION_NAME=nana-travel-mcp-server
LAMBDA_ROLE_NAME=nana-travel-mcp-lambda-role
# The caller the internal door requires at start: the real role of her door function nana-mcp (lane N6A; lane N0H had
# planned the name nana-door-invoker, which the door was never built with). INVOKER_GRANT=true makes the template add
# InternalInvokerInvoke for that one role, so her function's policy names her door's role and her deploy role and no other.
INTERNAL_INVOKER_ROLE_NAME=nana-door-role
INVOKER_GRANT=true

# --- her residence read (MOM-TSK-004-0H, lane N3H) ---
# Her finance residence-read function (finance-residence-read, lane N6E: finance.residence_periods.v1 for her travel role only), named WITHOUT an
# account id: a bare name is the function in her own account, so the template grants this role lambda:InvokeFunction on
# that one function only and finance's resource policy (lane N6E) admits travel's role. Her account id is never written.
FINANCE_READ_FUNCTION=finance-residence-read

# --- deploy-time settings (never reach the function). Shared code is read from io's repository, as ND-49 allows. ---
CODEARTIFACT_DOMAIN=io
CODEARTIFACT_OWNER=356364570033
CODEARTIFACT_REGION=us-west-2
CODEARTIFACT_REPOSITORY=io-kit
