# The second target of travel's one deploy path (MOM-TSK-007-0F, lane N6F): her deployment, in her own AWS account.
# Same format and loader as deploy/settings.env. Her account id is NEVER written in this repository: the workflow
# reads it from the repository variable named by ACCOUNT_ID_VARIABLE, and scripts/target_ops.py builds her role
# ARNs from it at run time. Not secret: names and regions.

# --- the target ---
TARGET_NAME=nana
ACCOUNT_ID_VARIABLE=NANA_AWS_ACCOUNT_ID
AWS_REGION=us-west-2
STACK_NAME=nana-travel-deployment
DEPLOY_ROLE_NAME=io-travel-deploy-github-role

# --- function settings (contract.SETTINGS) ---
TABLE_NAME=io-travel-flights
RECORDS_TABLE_NAME=io-travel-records
SURFACE_NAME=nana-travel
DOOR_MODE=internal

# --- names the stack gives its resources (her deploy role's grants name io-travel-* in her account) ---
FUNCTION_NAME=io-travel-mcp-server
LAMBDA_ROLE_NAME=io-travel-mcp-lambda-role
# The caller setting the internal door requires at start. It names her door's role (lane N0H's naming, set again by
# lane N6A) and grants nothing: the template's InvokerGrant stays false, so no invoker is admitted.
INTERNAL_INVOKER_ROLE_NAME=nana-door-invoker

# --- deploy-time settings (never reach the function). Shared code is read from io's repository, as ND-49 allows. ---
CODEARTIFACT_DOMAIN=io
CODEARTIFACT_OWNER=356364570033
CODEARTIFACT_REGION=us-west-2
CODEARTIFACT_REPOSITORY=io-kit
