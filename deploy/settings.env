# The settings of the deployment this repository's workflows deploy (FLY-TSK-028-0B, A-2).
# This file is the ONE place a deployment is named: the artifact (code, deploy script, workflows,
# manifests) carries none of it. A second deployment supplies its own file. Not secret: names, URLs,
# regions. Secrets and the sign-in pool binding stay in repository secrets. COGNITO_ALLOWED_SUBS and
# IOGRAPH_ALLOWED_SUBS are never committed; the deploy preserves them from the live function.
# Parsed by scripts/load_deployment_settings.py (KEY=VALUE, no quoting, no expansion).

# --- function settings (contract.SETTINGS) ---
TABLE_NAME=io-travel-flights
RECORDS_TABLE_NAME=io-travel-records
SURFACE_NAME=io-travel
# MOM-TSK-007-0I (lane N6I): finance's residence-read function (finance.residence_periods.v1, read-only), named WITHOUT an
# account id: a bare name is the function in this deployment's own account. Finance's resource policy for it admits this
# function's role and finance's deploy role, and no other. It replaces the router (finance-mcp), which admits the same role
# for every read. Finance deploys first (it makes the function); this setting reaches travel on travel's next deploy.
FINANCE_READ_FUNCTION=finance-residence-read
COGNITO_REGION=us-east-1
PUBLIC_BASE_URL=https://travel.thepup.io
CORS_ORIGINS=https://think.thepup.io
# --- which door (door.py, FLY-TSK-028-0D): io is a public edge; an internal deployment sets internal + INTERNAL_INVOKER_ROLE ---
DOOR_MODE=public

# --- deploy-time settings (never reach the function) ---
FUNCTION_NAME=io-travel-mcp-server
AWS_REGION=us-west-2
LAMBDA_ROLE_ARN=arn:aws:iam::356364570033:role/io-travel-mcp-lambda-role
CODEARTIFACT_DOMAIN=io
CODEARTIFACT_OWNER=356364570033
CODEARTIFACT_REGION=us-west-2
CODEARTIFACT_REPOSITORY=io-kit
PROBE_MCP_URL=https://travel.thepup.io/mcp
PROBE_SIGNIN_URL=https://connect.thepup.io

# --- the connector registry (ENC-ISS-919) ---
# io-kit ships no fleet registry: it names one principal's connectors. io's public edge supplies its own here (the one
# connector and profile it serves, in the fleet manifest's shape); the function reads it from IO_KIT_FLEET_JSON. Her target
# (deploy/targets/nana.env) supplies none and must never carry one.
IO_KIT_FLEET_JSON={"profiles":{"thepup":{"provider":"cognito","claim":"cognito","sign_in_service":"https://connect.thepup.io","issuer":"https://cognito-idp.us-west-2.amazonaws.com/us-west-2_y6bHKpNZN","jwks_uri":"https://cognito-idp.us-west-2.amazonaws.com/us-west-2_y6bHKpNZN/.well-known/jwks.json"}},"connectors":[{"name":"io-travel","runtime":"python","url":"https://travel.thepup.io","mount":"/mcp","profile":"thepup","client_ids":["6eh4u69l1mqk1m4hfjspeibla8"]}]}

# FLY-TSK-083: the read-only /records routes accept a human-door token from think only (public values; the key is
# the ES256 public half). Her target leaves these out, so her routes refuse every request.
RECORDS_DOOR_ISSUERS=https://think.thepup.io/auth
RECORDS_DOOR_AUDIENCE=io-travel-records
RECORDS_DOOR_PUBLIC_KEYS={"https://think.thepup.io/auth":"-----BEGIN PUBLIC KEY-----\nMIIBSzCCAQMGByqGSM49AgEwgfcCAQEwLAYHKoZIzj0BAQIhAP////8AAAABAAAA\nAAAAAAAAAAAA////////////////MFsEIP////8AAAABAAAAAAAAAAAAAAAA////\n///////////8BCBaxjXYqjqT57PrvVV2mIa8ZR0GsMxTsPY7zjw+J9JgSwMVAMSd\nNgiG5wSTamZ44ROdJreBn36QBEEEaxfR8uEsQkf4vOblY6RA8ncDfYEt6zOg9KE5\nRdiYwpZP40Li/hp/m47n60p8D54WK84zV2sxXs7LtkBoN79R9QIhAP////8AAAAA\n//////////+85vqtpxeehPO5ysL8YyVRAgEBA0IABCVSK7CG2AXbXNGbTbimXd+6\nrvXsUfriXeBSu0bYJgE7zOpEBk7XORHBRpoMC4lVB6IDSqeqH66LJhbkmmVAaxQ=\n-----END PUBLIC KEY-----"}
