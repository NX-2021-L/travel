# The settings of the deployment this repository's workflows deploy (FLY-TSK-028-0B, A-2).
# This file is the ONE place a deployment is named: the artifact (code, deploy script, workflows,
# manifests) carries none of it. A second deployment supplies its own file. Not secret: names, URLs,
# regions. Secrets and the sign-in pool binding stay in repository secrets. COGNITO_ALLOWED_SUBS and
# IOGRAPH_ALLOWED_SUBS are never committed; the deploy preserves them from the live function.
# Parsed by scripts/load_deployment_settings.py (KEY=VALUE, no quoting, no expansion).

# --- function settings (contract.SETTINGS) ---
TABLE_NAME=io-travel-flights
RECORDS_TABLE_NAME=io-travel-records
SURFACE_NAME=io-travel
FINANCE_READ_FUNCTION=https://c4anv3njlfakdhf75capqbhzwm0yhuea.lambda-url.us-west-2.on.aws/
COGNITO_REGION=us-east-1
PUBLIC_BASE_URL=https://travel.thepup.io
CORS_ORIGINS=https://think.thepup.io

# --- deploy-time settings (never reach the function) ---
FUNCTION_NAME=io-travel-mcp-server
AWS_REGION=us-west-2
LAMBDA_ROLE_ARN=arn:aws:iam::356364570033:role/io-travel-mcp-lambda-role
CODEARTIFACT_DOMAIN=io
CODEARTIFACT_OWNER=356364570033
CODEARTIFACT_REGION=us-west-2
CODEARTIFACT_REPOSITORY=io-kit
PROBE_MCP_URL=https://travel.thepup.io/mcp
